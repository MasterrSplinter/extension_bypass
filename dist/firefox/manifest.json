{
  "manifest_version": 3,
  "name": "Streaming AdBlocker Pro",
  "version": "1.7.0",
  "description": "Bloqueur de publicités et popups spécialisé pour les sites de streaming. Léger, rapide et invisible. Manifest V3.",
  "browser_specific_settings": {
    "gecko": {
      "id": "adblocker@streaming.pro",
      "strict_min_version": "120.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "scripting",
    "tabs",
    "webNavigation",
    "alarms",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_main",
        "enabled": true,
        "path": "rules/rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "comment": "ISOLATED WORLD — Sites streaming uniquement",
      "matches": [
        "*://*.webflix.lol/*",
        "*://*.french-stream.ac/*",
        "*://*.frenchstream.wtf/*",
        "*://*.papystreaming.tv/*",
        "*://*.voiranime.com/*",
        "*://*.filmcomplet.link/*",
        "*://*.streamcomplet.app/*",
        "*://*.wiflix.st/*",
        "*://*.annuaire-telechargement.art/*",
        "*://*.dpstreaming.to/*",
        "*://*.dpstreaming.ink/*",
        "*://*.cpasmieux.com/*",
        "*://*.cpasmieux.pro/*",
        "*://*.zone-telechargement.beauty/*",
        "*://*.senpai-stream.quest/*",
        "*://*.empire-streaming.us/*",
        "*://*.empire-streaming.com/*",
        "*://*.empire-streaming.net/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "comment": "ISOLATED WORLD — Lecteurs vidéo externes (player_cleaner.js)",
      "matches": [
        "*://*.wavewatch.top/*",
        "*://*.bysebuho.com/*",
        "*://*.nzn3.org/*",
        "*://*.player4k.com/*",
        "*://*.viperstreamz.com/*",
        "*://*.viperstream.xyz/*",
        "*://*.viper4k.com/*",
        "*://*.streamvid.net/*",
        "*://*.embedme.top/*",
        "*://*.filemoon.sx/*",
        "*://*.filemoon.in/*",
        "*://*.filemoon.com/*",
        "*://*.filemoon.to/*",
        "*://*.doodstream.com/*",
        "*://*.dood.wf/*",
        "*://*.dood.la/*",
        "*://*.streamtape.com/*",
        "*://*.streamtape.net/*",
        "*://*.turbovid.me/*",
        "*://*.supervideo.tv/*",
        "*://*.mixdrop.co/*",
        "*://*.mixdrop.to/*",
        "*://*.mp4upload.com/*",
        "*://*.fembed.com/*",
        "*://*.fembed.net/*"
      ],
      "js": [
        "content/player_cleaner.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "background/background.js"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Streaming AdBlocker Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["<all_urls>"]
    },
    {
      "comment": "main_world.js doit être accessible depuis toutes les origines car content.js s'exécute dans les iframes cross-origin des lecteurs vidéo. La protection du flag d'activation est assurée par le nonce (correctif H3).",
      "resources": ["content/main_world.js"],
      "matches": ["<all_urls>"]
    }
  ]
}